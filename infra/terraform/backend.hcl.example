bucket                      = "REPLACE_WITH_EXISTING_TFSTATE_BUCKET"
key                         = "dacare/staging/terraform.tfstate"
region                      = "ap-seoul-1"
access_key                  = "REPLACE_WITH_OCI_CUSTOMER_ACCESS_KEY"
secret_key                  = "REPLACE_WITH_OCI_CUSTOMER_SECRET_KEY"
skip_credentials_validation = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_region_validation      = true
use_path_style              = true
endpoints = {
  s3 = "https://REPLACE_NAMESPACE.compat.objectstorage.REPLACE_REGION.oraclecloud.com"
}
