#cloud-config
package_update: true
bootcmd:
  - mkdir -p /opt/dacare/runtime /opt/dacare/bin /opt/dacare/backups
packages:
  - docker.io
  - docker-compose-v2
  - oci-cli
  - curl
  - jq
users:
  - name: deploy
    groups: [docker]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD: /opt/dacare/bin/deploy, /opt/dacare/bin/backup"]
    ssh_authorized_keys:
      - ${deploy_ssh_public_key}
write_files:
  - path: /etc/ssh/sshd_config.d/99-dacare.conf
    permissions: '0644'
    content: |
      PasswordAuthentication no
      PermitRootLogin no
  - path: /opt/dacare/runtime/docker-compose.yml
    permissions: '0644'
    encoding: b64
    content: ${compose_file}
  - path: /opt/dacare/runtime/Caddyfile
    permissions: '0644'
    encoding: b64
    content: ${caddyfile}
  - path: /opt/dacare/bin/deploy
    permissions: '0750'
    encoding: b64
    content: ${deploy_script}
  - path: /opt/dacare/bin/backup
    permissions: '0750'
    encoding: b64
    content: ${backup_script}
  - path: /opt/dacare/vault-secret-ocid
    permissions: '0600'
    content: ${vault_secret_ocid}
  - path: /etc/cron.d/dacare-backup
    permissions: '0644'
    content: "15 3 * * * root /opt/dacare/bin/backup >> /var/log/dacare-backup.log 2>&1\n"
runcmd:
  - chown -R root:docker /opt/dacare
  - systemctl enable --now docker
  - systemctl restart ssh
